# PostgreSQL connection string. Works with a local Postgres, or a hosted one
# like Supabase, Neon, or Railway — any of them give you this URL directly.
DATABASE_URL="postgresql://user:password@localhost:5432/vitapulse"

# Any long random string — used to sign login sessions (JWTs).
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# From your Stripe dashboard (Developers -> API keys). Use the *test* keys
# until you're ready to charge real clinics.
STRIPE_SECRET_KEY="sk_test_..."

# From Stripe -> Developers -> Webhooks, after you add an endpoint pointing
# at https://yourdomain.com/billing/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# The Price ID (not Product ID) for your $140/month recurring plan, created
# in Stripe -> Product catalog. Billing is per-seat: this price is charged
# once per practitioner in the clinic (see routes/billing.js).
STRIPE_PRICE_ID="price_..."

# Where your frontend lives — Stripe redirects here after checkout.
APP_URL="http://localhost:3000"

PORT=4000
